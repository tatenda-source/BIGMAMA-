# BIGMAMA$ client configuration. Copy to .env.local for local dev.
# Values prefixed VITE_ are exposed to the browser bundle — never put
# secrets here.

# Point the frontend at a backend origin (omit for same-origin deploys).
# VITE_API_BASE=http://localhost:8787

# Hotspot data provider for HotspotMap.
#   usgs   (default) — live earthquakes, zero auth
#   firms  — NASA FIRMS active fires, requires VITE_FIRMS_MAP_KEY
#   local  — seeded sample data, offline-safe
VITE_HOTSPOT_PROVIDER=usgs

# Free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/ if
# you switch to the firms provider.
# VITE_FIRMS_MAP_KEY=
